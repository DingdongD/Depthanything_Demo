# Copy this file outside the repository or source it after replacing every path.
# No credentials are required by the build scripts.

export DEPTH_ANYTHING_CHECKPOINT=/opt/models/depth_anything_v2_vits.pth
export DS_TOOLCHAIN_ROOT=/opt/ds/DS_Toolchain_Demo_full
export DS_COMPILER="$DS_TOOLCHAIN_ROOT/python_bin/compile.py"
export DS_COMPILER_PYTHON=/opt/conda/envs/ds/bin/python
export DS_ARCH_16="$DS_TOOLCHAIN_ROOT/arch_16_mono.yaml"
export DS_ARCH_256="$DS_TOOLCHAIN_ROOT/arch_256_mono.yaml"

# ACMLIR/ACPC build used by the DS compiler Python wrapper.
export PYTHON_ROOT=/opt/ds/ACMLIR_DS/build
export ACOMPILER_EXTENSION_DIR="$PYTHON_ROOT/RelWithDebInfo/lib"

# Keep generated ONNX, calibration tensors, CFG/BIN and board evidence outside Git.
export DEPTHANYTHING_U250_BUILD_ROOT=/opt/build/depthanything-u250

# Board-only vendor runtime. It must contain the npz2bin extension and the
# architecture YAML files matching the loaded U250 bitstream.
export U250_RUNTIME_DIR=/opt/ds/nn_inference

# Calibration data. DA2K_DATASET_ROOT owns annotations.json and images/;
# DA2K_IMAGE_ROOT contains the scene directories below images/.
export NYU_H5_ROOT=/opt/data/nyu/h5
export DA2K_DATASET_ROOT=/opt/data/DA-2K
export DA2K_IMAGE_ROOT="$DA2K_DATASET_ROOT/images"
export DA2K_MANIFEST=/opt/data/DA-2K/manifest.json
export ATTENTION_JPEG_DIR=/opt/data/depthanything-attention-jpg
